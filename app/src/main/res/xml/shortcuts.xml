<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Kharcha Check icon: the three fastest ways in. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kharchacheck.app"
            android:targetClass="com.kharchacheck.app.MainActivity">
            <extra android:name="open" android:value="add" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="speak_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_speak_short"
        android:shortcutLongLabel="@string/shortcut_speak_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kharchacheck.app"
            android:targetClass="com.kharchacheck.app.MainActivity">
            <extra android:name="open" android:value="speak" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="add_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutShortLabel="@string/shortcut_income_short"
        android:shortcutLongLabel="@string/shortcut_income_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.kharchacheck.app"
            android:targetClass="com.kharchacheck.app.MainActivity">
            <extra android:name="open" android:value="income" />
        </intent>
    </shortcut>
</shortcuts>
